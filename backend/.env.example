# Documents the environment variables this backend reads. No real
# secrets here.
#
# IMPORTANT: copying this file to .env does NOT make it get loaded.
# There is no dotenv-loader (e.g. python-dotenv) in this project yet —
# these variables must actually be set in the process environment,
# e.g. in PowerShell:
#   $env:TRADING_AI_DATABASE_URL = "postgresql+asyncpg://user:password@localhost:5432/trading_ai"
#
# TRADING_AI_DATABASE_URL is NOT required to import/start the
# application or to use GET /health. It IS required for GET /ready to
# report success and for any Alembic command.
TRADING_AI_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading_ai

# Optional (defaults shown).
TRADING_AI_ENVIRONMENT=development
TRADING_AI_LOG_LEVEL=INFO
TRADING_AI_HOST=127.0.0.1
TRADING_AI_PORT=8000
TRADING_AI_DEBUG=false

# CORS allowlist for browser requests, comma-separated. Default (if
# unset) is loopback-only for the local Next.js dev server:
# http://localhost:3000,http://127.0.0.1:3000
# TRADING_AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Market data (Twelve Data — https://twelvedata.com/docs, free-tier API
# key required, no scraping/reverse-engineered endpoints). Optional: if
# unset, the whole application still starts; only GET /watchlist/quotes
# returns 503 ("market data is not configured") — POST/GET/DELETE
# /watchlist are unaffected. Never logged, never returned to the
# frontend (only backend calls the provider).
TRADING_AI_MARKET_DATA_API_KEY=

# Instrument news (Finnhub — https://finnhub.io, free-tier API key
# required, no scraping). Separate provider/secret from market data —
# Twelve Data has no usable news endpoint (see README). Optional: if
# unset, the whole application still starts; only
# GET /instruments/{ticker}/news returns 503 ("news is not
# configured"). Never logged, never returned to the frontend.
TRADING_AI_NEWS_API_KEY=
