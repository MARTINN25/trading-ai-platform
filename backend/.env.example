# Documents the environment variables this backend reads. No real
# secrets here.
#
# IMPORTANT: copying this file to .env does NOT make it get loaded.
# There is no dotenv-loader (e.g. python-dotenv) in this project yet —
# these variables must actually be set in the process environment,
# e.g. in PowerShell:
#   $env:TRADING_AI_DATABASE_URL = "postgresql+asyncpg://user:password@localhost:5432/trading_ai"
#
# TRADING_AI_DATABASE_URL is NOT required to import/start the
# application or to use GET /health. It IS required for GET /ready to
# report success and for any Alembic command.
TRADING_AI_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading_ai

# Optional (defaults shown).
TRADING_AI_ENVIRONMENT=development
TRADING_AI_LOG_LEVEL=INFO
TRADING_AI_HOST=127.0.0.1
TRADING_AI_PORT=8000
TRADING_AI_DEBUG=false
