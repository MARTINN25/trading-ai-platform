# Documents the variables compose.yaml interpolates for the local
# PostgreSQL runtime. This is a *different* mechanism from the
# application's own configuration (backend/.env.example,
# TRADING_AI_DATABASE_URL) — see the Compose secrets/environment
# variables distinction in ADR-0008 §29.
#
# Copy this file to .env.compose and put a real local-only password in
# it, then run:
#   docker compose --env-file .env.compose up -d
#
# .env.compose is gitignored and must never be committed. These are
# local development credentials only, not production secrets.

POSTGRES_USER=trading_ai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trading_ai

# Host-side port PostgreSQL is published on, bound to 127.0.0.1 only
# (see compose.yaml). Deliberately not 5432 — that default is reserved
# for a possible PostgreSQL instance already installed natively on the
# developer's machine; this Compose runtime never touches it. The
# container-side port is always 5432 regardless of this value.
POSTGRES_HOST_PORT=55432
