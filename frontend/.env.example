# Documents the environment variables this frontend reads.
#
# Copy this file to .env.local for local development:
#   Copy-Item .env.example .env.local
# .env.local is gitignored and never committed (see root .gitignore).
#
# NEXT_PUBLIC_API_BASE_URL — base URL of the FastAPI backend (ADR-0002)
# this frontend talks to. The NEXT_PUBLIC_ prefix means Next.js inlines
# this value into the browser bundle — it is PUBLIC by definition, not
# a secret (ADR-0003, §25). Never put a server secret behind this
# prefix or any other NEXT_PUBLIC_ variable.
#
# If unset, the API client (frontend/src/lib/watchlist-api.ts) falls
# back to the same development default shown below — that fallback is
# defined in exactly one place, not hardcoded per-component.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
